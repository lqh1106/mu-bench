{
  "output_root": "outputs",
  "auto_cleanup": true,
  "case_timeout_seconds": 6000,
  "text": {
    "base_url": "http://127.0.0.1:18992/v1",
    "api_key": {"env": "MUBENCH_GATEWAY_KEY"},
    "model": "gpt-6-luna"
  },
  "speech": {"tts_endpoint": "${REPO_ROOT}/outputs/services/tts.json"},
  "sut": {
    "provider": "native",
    "model": "minicpm",
    "transport": "audio",
    "endpoints": ["${REPO_ROOT}/outputs/services/minicpm.json"]
  }
}
